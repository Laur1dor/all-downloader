# Маршрутизация по платформам. Файл читается на лету — правка применяется
# без перезапуска бота.
#
# Политики:
#   direct              всегда напрямую
#   main                каскад goida → bypass → main (личная нода последней)
#   goida               каскад goida → bypass → main
#   bypass              каскад bypass → goida → main
#   adaptive            напрямую пока платформа доступна, иначе каскад
#   socks5h://host:port конкретный внешний прокси (например WARP)
#   vless://...         нода, закреплённая за платформой через domain-routing
#
# Одного прокси на всё не бывает: одна площадка банит адреса дата-центров,
# другой нужен стабильный выходной IP, третья считает ротирующийся пул ботом.
# Поэтому политика задаётся отдельно для каждой платформы.

[defaults]
policy = "adaptive"
# Если личная нода умерла — весь трафик уходит в бесплатный пул, чтобы один
# сбой не ронял бота целиком.
main_fallback = "goida"

[services]
# Пример рабочей раскладки для сети, где VLESS режется DPI:
#   tiktok  = "goida"                  # адреса Cloudflare у него в бане
#   youtube = "socks5h://warp:1080"    # на ротирующемся пуле требует вход в аккаунт
tiktok      = "main"
rule34      = "goida"
rule34video = "socks5h://warp:1080"
