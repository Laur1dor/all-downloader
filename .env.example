# Telegram
BOT_TOKEN=123456:ABC-your-bot-token
ADMIN_ID=123456789   # your numeric Telegram user id (e.g. from @userinfobot)
#SUGGESTIONS_CHAT_ID=-1001234567890  # dedicated private group or topic chat for ideas
#NEWS_CHANNEL_ID=@your_channel     # add bot as channel admin with post permission

# PostgreSQL
DB_NAME=mediadl
DB_USER=mediadl
DB_PASSWORD=change-me
DB_HOST=postgres
DB_PORT=5432

# Optional overrides
#HEALTH_PORT=30080
# Owner dashboard: use the server's LAN address in your private .env.
DASHBOARD_LOCAL_URL=http://localhost:30080/stats/
#COOKIES_FILE=data/cookies.txt
#LEGACY_DUMP_FILE=info.txt
#MAX_UPLOAD_MB=2000
#MEDIA_SEND_SPACING_SECONDS=2.5  # minimum spacing between media sends; albums count per item

# Self-hosted Bot API server for large uploads (COMPOSE_PROFILES=local-api).
# Get TELEGRAM_API_ID/HASH at https://my.telegram.org -> API development tools.
#TELEGRAM_API_ID=
#TELEGRAM_API_HASH=
#TELEGRAM_API_URL=http://telegram-bot-api:8081

# Adaptive proxy routing (COMPOSE_PROFILES=vless). The bot goes direct while a
# site is reachable and falls back to this proxy only when it is blocked.
#PROXY_URL=socks5h://xray:2080
# HTTP proxy for spotdl (Spotify's API is geo-blocked in some regions).
#SPOTDL_HTTP_PROXY=http://xray:2081
# Route verified Spotify-to-YouTube audio through WARP if direct media stalls.
#SPOTIFY_AUDIO_PROXY=socks5h://warp:1080
#VLESS_SUBSCRIPTION=https://example.com/sub/xxxx
# When both vless and warp profiles are enabled, use WARP if every Xray pool
# node is marked unavailable. Leave disabled without a running warp service.
#XRAY_WARP_FALLBACK=1

# Free public fallback pool (e.g. AvenCores/goida-vpn-configs raw .txt files).
# Used for IP-banned sites and when the main node is down. Per-service routing is
# controlled by data/routing.toml. Empty = disabled.
# Optional override: Compose already uses the six current GitLab mirror feeds
# (1, 6, 22, 23, 24, 25). Remove any old AvenCores GitHub URLs from .env:
# that repository now returns 404. Comma-separate only the feeds you need.
#GOIDA_SUBSCRIPTIONS=https://gitlab.com/avencores/goida-vpn-configs/-/raw/main/githubmirror/1.txt
#GOIDA_FETCH_WORKERS=3
#MAX_SUBSCRIPTION_BYTES=8388608
#SUBSCRIPTION_FETCH_TIMEOUT=12
#GOIDA_PROXY_URL=socks5h://xray:2079
#GOIDA_POOL_SIZE=50
#VLESS_CONFIGS=vless://...,vless://...
#VLESS_CONFIGS_FILE=data/vless.txt
#VLESS_UPDATE_INTERVAL=21600

# Enable extra services, comma-separated: local-api, vless
#COMPOSE_PROFILES=local-api,vless

# Ceilings for the admin control panel's custom speed values (Mbit/s).
#MAIN_MAX_MBIT=1000     # main uplink — caps user/admin/total-channel speeds
#VPN_MAX_MBIT=1000      # VLESS node uplink — caps the VPN-channel speed

# Каким туннелем свой Bot API ходит в Telegram. По умолчанию VLESS-пул; если
# VLESS в вашей сети не проходит — socks5://warp:1080.
#TUN2SOCKS_PROXY=socks5://warp:1080

# Пробер бесплатного пула: сколько кандидатов брать за круг, сколько из них
# проверять по-настоящему (дорого), сколько живых набрать и как часто повторять.
#GOIDA_PROBE_SAMPLE=900
#GOIDA_PROBE_DEEP=400
#GOIDA_LIVE_TARGET=25
#GOIDA_PROBE_INTERVAL=1800

# rule34.xxx закрыл HTML интерактивной проверкой Cloudflare; медиа берутся
# через его API, а он требует ключ. Взять: аккаунт на сайте → Account → Options.
#RULE34_API_KEY=
#RULE34_USER_ID=

# --- Instagram --------------------------------------------------------------
# Instagram has no public API and ties a session to the address it was made
# from, so the bot logs in itself, from the machine that will use the session,
# instead of anyone exporting cookies from a browser every fortnight.
# Run it with /iglogin after filling these in.
IG_USERNAME=
IG_PASSWORD=
# Where the verification code arrives. With two-factor on the MAIL account this
# must be an app password, not the account password
# (Gmail: https://myaccount.google.com/apppasswords).
IG_IMAP_HOST=imap.gmail.com
IG_IMAP_USER=
IG_IMAP_PASSWORD=
